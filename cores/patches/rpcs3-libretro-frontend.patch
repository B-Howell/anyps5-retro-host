+			const auto& cached_object = **object_file;
+			if (!cached_object.isELF() || cached_object.getArch() != llvm::Triple::x86_64 ||
+				!cached_object.isRelocatableObject())
+			{
+				jit_log.error("LLVM: Invalid cached SPU object architecture or type: %s", path);
+				return nullptr;
+			}
+
+			bool has_expected_entry = false;
+			for (const auto& symbol : cached_object.symbols())
+			{
+				auto name = symbol.getName();
+				if (!name)
+				{
+					llvm::consumeError(name.takeError());
+					return nullptr;
+				}
+				if (name->str() != expected_entry)
+				{
+					continue;
+				}
+				auto flags = symbol.getFlags();
+				if (!flags)
+				{
+					llvm::consumeError(flags.takeError());
+					return nullptr;
+				}
+				has_expected_entry = (*flags & llvm::object::SymbolRef::SF_Undefined) == 0;
+				break;
+			}
+			if (!has_expected_entry)
+			{
+				jit_log.error("LLVM: Cached SPU object has no matching defined entry: %s", expected_entry);
+				return nullptr;
+			}
