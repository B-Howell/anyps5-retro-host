+			const std::string module_name = _module->getName().str();
+			constexpr std::string_view cache_prefix = "spu-objects-v1-";
+			constexpr std::string_view cache_suffix = ".obj";
+			if (!module_name.starts_with(cache_prefix))
+			{
+				jit_log.notice("LLVM: Loaded module: %s", _module->getName().data());
+				return buf;
+			}
+
+			const size_t digest_separator = module_name.rfind('-');
+			if (digest_separator == std::string::npos || !module_name.ends_with(cache_suffix))
+			{
+				jit_log.error("LLVM: Invalid cached SPU object name: %s", module_name);
+				return nullptr;
+			}
+			const std::string expected_entry = module_name.substr(
+				cache_prefix.size(), digest_separator - cache_prefix.size());
+
+			auto object_file = llvm::object::ObjectFile::createObjectFile(*buf);
+			if (!object_file)
+			{
+				llvm::consumeError(object_file.takeError());
