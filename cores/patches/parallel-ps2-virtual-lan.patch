+/* SPDX-License-Identifier: LGPL-3.0-or-later */
+#pragma once
+
+#include <libretro.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Bind before retro_load_game and unbind after retro_unload_game. The core
+ * copies the descriptor. Keep opaque and the callbacks alive until unbind.
+ * Callbacks run on the emulator's transmit and receive threads. They may not
+ * block, and send must copy any frame it keeps after returning. recv returns
+ * the frame length or zero for an empty queue. Frames have no FCS. */
+struct retro_anyps5_dev9_transport_v1
+{
+	void* opaque;
+	uint8_t mac[6];
+	bool (RETRO_CALLCONV *send)(void* opaque, const void* bytes, size_t size);
+	size_t (RETRO_CALLCONV *recv)(void* opaque, void* bytes, size_t capacity);
+};
+
+RETRO_API bool retro_anyps5_dev9_bind_v1(const struct retro_anyps5_dev9_transport_v1* transport);
+
+#ifdef __cplusplus
+}
+#endif
