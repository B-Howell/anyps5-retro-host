+static retro_anyps5_dev9_transport_v1 s_virtual_lan{};
+
+RETRO_API bool retro_anyps5_dev9_bind_v1(const retro_anyps5_dev9_transport_v1* transport)
+{
+	if (nif)
+		return false;
+	if (!transport)
+	{
+		s_virtual_lan = {};
+		return true;
+	}
+	const uint8_t zero_mac[6] = {};
+	if (!transport->send || !transport->recv || (transport->mac[0] & 1) ||
+		memcmp(transport->mac, zero_mac, sizeof(zero_mac)) == 0)
+		return false;
+	s_virtual_lan = *transport;
+	return true;
+}
+
+class AnyPs5VirtualLan final : public NetAdapter
+{
+	static constexpr size_t MIN_FRAME = 14;
+	static constexpr size_t MAX_FRAME = 1514;
+	const retro_anyps5_dev9_transport_v1 m_transport;
+
+public:
+	explicit AnyPs5VirtualLan(const retro_anyps5_dev9_transport_v1& transport)
+		: m_transport(transport)
+	{
+		PacketReader::MAC_Address mac{};
+		memcpy(&mac, m_transport.mac, sizeof(m_transport.mac));
+		SetMACAddress(&mac);
+	}
+
+	bool isInitialised() override { return true; }
+	void reloadSettings() override {}
+
+	bool recv(NetPacket* pkt) override
+	{
+		const size_t size = m_transport.recv(m_transport.opaque, pkt->buffer, MAX_FRAME);
+		if (size < MIN_FRAME || size > MAX_FRAME)
+			return false;
+		pkt->size = static_cast<int>(size);
+		return true;
+	}
+
+	bool send(NetPacket* pkt) override
+	{
+		return pkt->size >= static_cast<int>(MIN_FRAME) && pkt->size <= static_cast<int>(MAX_FRAME) &&
+			m_transport.send(m_transport.opaque, pkt->buffer, static_cast<size_t>(pkt->size));
+	}
+};
