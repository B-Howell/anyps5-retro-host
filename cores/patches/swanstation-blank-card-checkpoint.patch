+bool MemoryCard::DoBlankState(StateWrapper& sw) const
+{
+  if (!sw.IsWriting() || !CanExportBlank())
+    return false;
+
+  // Preserve the status that the console sees when it selects this slot.
+  // Use a clean data image and transfer fields with no card contents.
+  auto blank = Create();
+  blank->m_FLAG = m_FLAG;
+  blank->m_changed = m_changed;
+  return blank->DoState(sw);
+}
