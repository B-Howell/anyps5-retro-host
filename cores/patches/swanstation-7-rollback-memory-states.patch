-    for (size_t i = 0; i < count; i++)
-      Do(&values[i]);
+    /* Do() writes an integer or float as its bytes, so an array of them is the same bytes in one copy.
+     * One stream call per element made in-memory states (runahead, rollback) cost twice their copies.
+     * A bool keeps Do(bool*), which reads any byte but 0 as true. */
+    if constexpr ((std::is_integral_v<T> && !std::is_same_v<T, bool>) || std::is_floating_point_v<T>)
