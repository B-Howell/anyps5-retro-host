+struct rpcn_identity
+{
+    std::string host;
+    std::string certificate_sha256;
+};
+
+inline std::optional<rpcn_identity> make_rpcn_identity(const char* host, const char* certificate)
+{
+    if (!host || !certificate)
+        return std::nullopt;
+    const std::string_view endpoint(host), digest(certificate);
+    const auto endpoint_char = [](char c)
+    {
+        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+            (c >= '0' && c <= '9') || c == '.' || c == '-' || c == ':';
+    };
+    const auto hex = [](char c) { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'); };
+    if (endpoint.empty() || endpoint.size() > 255 || !std::ranges::all_of(endpoint, endpoint_char) ||
+        digest.size() != 64 || !std::ranges::all_of(digest, hex))
+        return std::nullopt;
+    return rpcn_identity{host, certificate};
+}
+
+const rpcn_identity* required_rpcn_identity();
 const patch_requirement* required_patch();
 void begin_patch_verification();
 void finish_patch_verification();
