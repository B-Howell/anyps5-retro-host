+// As VRAMRGBA5551ToRGBA8888 on the CPU: each 5-bit channel to the nearest 8-bit value, given as an exact multiple
+// of 1/255 so every GPU stores the same byte. x / 31 lies halfway between two bytes for some x, and GPUs round it
+// either way, so VRAM uploaded from a state would differ from VRAM the game filled.
 float4 RGBA5551ToRGBA8(uint v)
 {
-  uint r = (v & 31u);
-  uint g = ((v >> 5) & 31u);
-  uint b = ((v >> 10) & 31u);
+  uint r = ((v & 31u) * 527u + 23u) >> 6;
+  uint g = (((v >> 5) & 31u) * 527u + 23u) >> 6;
+  uint b = (((v >> 10) & 31u) * 527u + 23u) >> 6;
   uint a = ((v >> 15) & 1u);
 
-  return float4(float(r) / 31.0, float(g) / 31.0, float(b) / 31.0, float(a));
+  return float4(float(r) / 255.0, float(g) / 255.0, float(b) / 255.0, float(a));
 }
 )";
