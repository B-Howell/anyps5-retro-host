+// The frontend passes the 32-byte SHA-256 of its verified, currently mounted disc.
+extern "C" RETRO_API size_t retro_anyps5_export_checkpoint_v1(void* data, size_t capacity,
+                                                             const uint8_t* disc_hash)
+{
+  if (!data || !disc_hash || capacity <= CHECKPOINT_PREFIX_SIZE ||
+      capacity - CHECKPOINT_PREFIX_SIZE > System::MAX_SAVE_STATE_SIZE || !System::HasMedia() ||
+      System::GetRunningCode().empty())
+    return 0;
+
+  auto* bytes = static_cast<uint8_t*>(data);
+  auto stream = ByteStream_CreateMemoryStream(bytes + CHECKPOINT_PREFIX_SIZE,
+                                             static_cast<uint32_t>(capacity - CHECKPOINT_PREFIX_SIZE));
+  if (!System::SaveState(stream.get(), false))
+    return 0;
+
+  std::memcpy(bytes, PORTABLE_CHECKPOINT_V1.data(), PORTABLE_CHECKPOINT_V1.size());
+  std::memcpy(bytes + PORTABLE_CHECKPOINT_V1.size(), disc_hash, CHECKPOINT_DISC_HASH_SIZE);
+  return CHECKPOINT_PREFIX_SIZE + static_cast<size_t>(stream->GetPosition());
+}
+
+extern "C" RETRO_API bool retro_anyps5_import_checkpoint_v1(const void* data, size_t size,
+                                                           const uint8_t* disc_hash)
+{
+  const size_t prefix = CHECKPOINT_PREFIX_SIZE;
+  if (!data || !disc_hash || size <= prefix + sizeof(SAVE_STATE_HEADER) || size - prefix > System::MAX_SAVE_STATE_SIZE ||
+      !System::HasMedia())
+    return false;
+
+  const auto* bytes = static_cast<const uint8_t*>(data);
+  if (std::memcmp(bytes, PORTABLE_CHECKPOINT_V1.data(), PORTABLE_CHECKPOINT_V1.size()) != 0 ||
+      std::memcmp(bytes + PORTABLE_CHECKPOINT_V1.size(), disc_hash, CHECKPOINT_DISC_HASH_SIZE) != 0)
+    return false;
+
+  SAVE_STATE_HEADER header;
+  std::memcpy(&header, bytes + prefix, sizeof(header));
+  const std::string& code = System::GetRunningCode();
+  char expected_code[sizeof(header.game_code)] = {};
+  if (code.empty() || code.size() >= sizeof(expected_code))
+    return false;
+  std::memcpy(expected_code, code.data(), code.size());
+  if (header.magic != SAVE_STATE_MAGIC || header.version != SAVE_STATE_VERSION || header.media_filename_length ||
+      header.offset_to_media_filename || header.media_subimage_index || header.data_compression_type ||
+      header.offset_to_data != sizeof(header) || header.data_uncompressed_size != size - prefix - sizeof(header) ||
+      std::memcmp(header.game_code, expected_code, sizeof(expected_code)) != 0)
+    return false;
+
+  const std::string local_media = System::GetMediaFileName();
+  if (local_media.empty())
+    return false;
+  auto stream = ByteStream_CreateReadOnlyMemoryStream(bytes + prefix, static_cast<uint32_t>(size - prefix));
+  return System::LoadState(stream.get(), false, true, local_media.c_str(), System::GetMediaSubImageIndex());
+}
