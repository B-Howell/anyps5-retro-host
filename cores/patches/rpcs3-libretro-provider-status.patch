diff --git a/rpcs3/libretro/anyps5_provider_status.h b/rpcs3/libretro/anyps5_provider_status.h
new file mode 100644
--- /dev/null
+++ b/rpcs3/libretro/anyps5_provider_status.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace anyps5
+{
+enum class provider_status : std::int32_t
+{
+    waiting = 0,
+    connecting = 1,
+    signaling = 2,
+    ready = 3,
+    connection_failed = 4,
+    login_rejected = 5,
+    signaling_failed = 6,
+};
+
+inline std::atomic<provider_status> ps3_provider_status{provider_status::waiting};
+}
