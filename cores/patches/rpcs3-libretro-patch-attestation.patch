+#ifdef LIBRETRO_CORE
+bool patch_engine::load_verified_title_patch(const std::string& title, const std::string& version,
+	const std::string& sha256, const std::string& hash, const std::map<std::string, unsigned>& expected)
+{
+	const std::string path = fmt::format("%s%s_patch.yml", get_patches_path(), title);
+	const fs::file file{path};
+	if (!file)
+		return false;
+
+	const u64 size = file.size();
+	if (!size || size > 1024 * 1024)
+		return false;
+	std::string content(size, '\0');
+	if (file.read(content.data(), size) != size || file.size() != size ||
+		sha256_get_hash(content.data(), content.size(), true) != sha256)
+		return false;
+
+	// Ignore user configuration and base/imported definitions for this boot.
+	patch_map reviewed;
+	if (!load(reviewed, path, std::move(content), true) || reviewed.size() != 1 || !reviewed.contains(hash))
+		return false;
+	auto& patches = reviewed.at(hash).patch_info_map;
+	if (patches.size() != expected.size())
+		return false;
+
+	for (auto& [description, patch] : patches)
+	{
+		if (!expected.contains(description))
+			return false;
+		bool found = false;
+		for (auto& [game, serials] : patch.titles)
+		{
+			for (auto& [serial, versions] : serials)
+			{
+				for (auto& [revision, settings] : versions)
+				{
+					const bool exact = serial == title && revision == version;
+					if (exact && found)
+						return false;
+					settings.enabled = exact;
+					found |= exact;
+				}
+			}
+		}
+		if (!found)
+			return false;
+	}
+
+	m_map = std::move(reviewed);
+	m_applied_groups.clear();
+	return true;
+}
+#endif
