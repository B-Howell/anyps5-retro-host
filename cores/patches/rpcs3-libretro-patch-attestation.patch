diff --git a/rpcs3/libretro/anyps5_patch_attestation.h b/rpcs3/libretro/anyps5_patch_attestation.h
new file mode 100644
index 0000000..685f54f
--- /dev/null
+++ b/rpcs3/libretro/anyps5_patch_attestation.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <algorithm>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace anyps5_ps3
+{
+using patch_writes = std::map<std::string, unsigned>;
+
+struct patch_requirement
+{
+    std::string title;
+    std::string version;
+    std::string sha256;
+    std::string ppu_hash;
+    patch_writes writes;
+
+    bool matches_executable(std::string_view serial, std::string_view revision, std::string_view hash) const
+    {
+        return title == serial && version == revision && ppu_hash == hash;
+    }
+};
+
+inline std::optional<patch_requirement> make_patch_requirement(
+    const char* title, const char* version, const char* sha256, const char* ppu_hash,
+    unsigned count, const char* const* names, const unsigned* writes)
+{
+    if (!title || !version || !sha256 || !ppu_hash || !count || count > 8 || !names || !writes)
+        return std::nullopt;
+
+    const std::string_view serial(title), revision(version), digest(sha256), hash(ppu_hash);
+    const auto digit = [](char c) { return c >= '0' && c <= '9'; };
+    const auto letter = [](char c) { return c >= 'A' && c <= 'Z'; };
+    const auto hex = [&](char c) { return digit(c) || (c >= 'a' && c <= 'f'); };
+    if (serial.size() != 9 || !std::ranges::all_of(serial.substr(0, 4), letter) ||
+        !std::ranges::all_of(serial.substr(4), digit) ||
+        revision.size() != 5 || revision[2] != '.' || !std::ranges::all_of(revision.substr(0, 2), digit) ||
+        !std::ranges::all_of(revision.substr(3), digit) ||
+        digest.size() != 64 || !std::ranges::all_of(digest, hex) ||
+        hash.size() != 44 || !hash.starts_with("PPU-") || !std::ranges::all_of(hash.substr(4), hex))
+        return std::nullopt;
+
+    patch_requirement result{title, version, sha256, ppu_hash, {}};
+    const auto name_character = [&](char c)
+    {
+        return digit(c) || letter(c) || (c >= 'a' && c <= 'z') ||
+            std::string_view{" ._()-"}.find(c) != std::string_view::npos;
+    };
+    for (unsigned i = 0; i < count; ++i)
+    {
+        if (!names[i] || !writes[i] || writes[i] > 4096)
+            return std::nullopt;
+        const std::string_view name(names[i]);
+        if (name.empty() || name.size() > 96 || !std::ranges::all_of(name, name_character) ||
+            !result.writes.emplace(name, writes[i]).second)
+            return std::nullopt;
+    }
+    return result;
+}
+
+const patch_requirement* required_patch();
+void begin_patch_verification();
+void finish_patch_verification();
+}
