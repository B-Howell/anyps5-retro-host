{
  "description": "Start while a game is loaded.",
  "from": "launcher",
  "message": {
    "type": "call",
    "id": 9,
    "method": "start",
    "args": {
      "core": "${core}",
      "disc": "${disc}",
      "system": "${system}",
      "saves": "${saves}",
      "options": {
        "swanstation_GPU_ResolutionScale": "4",
        "swanstation_GPU_TextureFilter": "Bilinear"
      }
    }
  },
  "reply": {
    "type": "reply",
    "id": 9,
    "error": {
      "code": "busy",
      "message": "A game is already loaded."
    }
  }
}
