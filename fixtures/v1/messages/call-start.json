{
  "description": "Start a two-disc game from its playlist, booting the second disc.",
  "from": "launcher",
  "message": {
    "type": "call",
    "id": 2,
    "method": "start",
    "args": {
      "core": "${core}",
      "disc": "${playlist}",
      "system": "${system}",
      "saves": "${saves}",
      "options": {
        "swanstation_GPU_ResolutionScale": "4",
        "swanstation_GPU_TextureFilter": "Bilinear"
      },
      "initialDisc": 1
    }
  },
  "reply": {
    "type": "reply",
    "id": 2,
    "result": {
      "epoch": 1
    }
  }
}
