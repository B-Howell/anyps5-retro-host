{
  "description": "Start a two-disc game from its playlist, booting the second disc.",
  "from": "launcher",
  "message": {
    "type": "call",
    "id": 1,
    "method": "start",
    "args": {
      "core": "${core}",
      "disc": "${playlist}",
      "system": "${system}",
      "saves": "${saves}",
      "internalResolution": "4",
      "options": {
        "swanstation_GPU_TextureFilter": "Bilinear"
      },
      "initialDisc": {
        "index": 1,
        "path": "${disc2}"
      }
    }
  },
  "reply": {
    "type": "reply",
    "id": 1,
    "result": {
      "epoch": 1
    }
  }
}
