{
  "description": "The launcher offers only a pixel format this host does not know.",
  "tests": [
    "host"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgb565"
        ]
      }
    },
    {
      "from": "host",
      "message": {
        "type": "unsupported",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8"
        ]
      },
      "anyValueFor": [
        "pixelFormats"
      ]
    },
    {
      "hostExits": 0
    }
  ],
  "outcome": "unsupported"
}
