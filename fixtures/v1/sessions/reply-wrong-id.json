{
  "description": "The host replies with an id no call is waiting for.",
  "tests": [
    "launcher"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8",
          "bgra8"
        ]
      },
      "anyValueFor": [
        "pixelFormats"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "welcome",
        "version": 1,
        "pid": 4242,
        "hostVersion": "1.0.0",
        "capabilities": [
          "ps1"
        ],
        "pixelFormat": "rgba8"
      },
      "anyValueFor": [
        "pid",
        "hostVersion",
        "pixelFormat"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 1,
        "method": "volume",
        "args": {
          "level": 1,
          "muted": false
        }
      },
      "anyValueFor": [
        "id",
        "args"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "reply",
        "id": 1,
        "result": null
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 2,
        "method": "start",
        "args": {
          "core": "${core}",
          "disc": "${disc}",
          "system": "${system}",
          "saves": "${saves}",
          "options": {
            "swanstation_GPU_ResolutionScale": "4",
            "swanstation_GPU_TextureFilter": "Bilinear"
          }
        }
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "reply",
        "id": 2,
        "result": {
          "epoch": 1
        }
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 3,
        "method": "status"
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "reply",
        "id": 99,
        "result": null
      },
      "invalid": "a reply answers the oldest waiting call"
    }
  ],
  "outcome": "protocolError"
}
