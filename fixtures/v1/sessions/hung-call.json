{
  "description": "A call has no reply after 5 seconds.",
  "tests": [
    "launcher"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8",
          "bgra8"
        ]
      }
    },
    {
      "from": "host",
      "message": {
        "type": "welcome",
        "version": 1,
        "pid": 4242,
        "hostVersion": "1.0.0",
        "capabilities": [
          "ps1"
        ],
        "pixelFormat": "rgba8"
      },
      "anyValueFor": [
        "pid",
        "hostVersion"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 1,
        "method": "start",
        "args": {
          "core": "/home/p/.local/share/anyps5/cores/swanstation_libretro.so",
          "disc": "/home/p/Games/PS1/Crash Team Racing/Crash Team Racing.cue",
          "system": "/home/p/.local/share/anyps5/retro/system",
          "saves": "/home/p/.local/share/anyps5/retro/saves/ps1",
          "internalResolution": "4",
          "options": {
            "swanstation_GPU_TextureFilter": "Bilinear"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "type": "reply",
        "id": 1,
        "result": {
          "epoch": 1
        }
      }
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 2,
        "method": "status"
      }
    },
    {
      "wait": 5.5
    },
    {
      "launcherKillsHost": true
    },
    {
      "launcherReports": {
        "method": "status",
        "result": {
          "ready": false,
          "ended": true,
          "error": "The emulator stopped responding and was closed."
        }
      }
    }
  ],
  "outcome": "hostFailure"
}
