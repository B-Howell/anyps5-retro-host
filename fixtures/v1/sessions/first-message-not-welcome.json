{
  "description": "The host sends a frame before welcome.",
  "tests": [
    "launcher"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8",
          "bgra8"
        ]
      },
      "anyValueFor": [
        "pixelFormats"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "frame"
      },
      "invalid": "the first host message is welcome or unsupported"
    }
  ],
  "outcome": "protocolError"
}
