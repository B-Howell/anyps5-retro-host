{
  "description": "slotBytes above the 268,435,456 limit.",
  "tests": [
    "launcher"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8",
          "bgra8"
        ]
      },
      "anyValueFor": [
        "pixelFormats"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "welcome",
        "version": 1,
        "pid": 4242,
        "hostVersion": "1.0.0",
        "capabilities": [
          "ps1"
        ],
        "pixelFormat": "rgba8"
      },
      "anyValueFor": [
        "pid",
        "hostVersion",
        "pixelFormat"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 1,
        "method": "start",
        "args": {
          "core": "${core}",
          "disc": "${disc}",
          "system": "${system}",
          "saves": "${saves}",
          "internalResolution": "4",
          "options": {
            "swanstation_GPU_TextureFilter": "Bilinear"
          }
        }
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "reply",
        "id": 1,
        "result": {
          "epoch": 1
        }
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "ring",
        "bytes": 3298534887424
      },
      "descriptors": 1,
      "ring": {
        "memoryBytes": 3298534887424,
        "sealed": true,
        "header": {
          "magic": 1179792705,
          "version": 1,
          "slotCount": 3,
          "headerBytes": 4096,
          "slotBytes": 1099511627776,
          "latest": 4294967295,
          "reading": 4294967295,
          "pixelFormat": 1,
          "slots": [
            {
              "width": 0,
              "height": 0,
              "visible": 0,
              "epoch": 0,
              "sequence": 0
            },
            {
              "width": 0,
              "height": 0,
              "visible": 0,
              "epoch": 0,
              "sequence": 0
            },
            {
              "width": 0,
              "height": 0,
              "visible": 0,
              "epoch": 0,
              "sequence": 0
            }
          ]
        }
      },
      "invalid": "slotBytes must be an integer from 4 to 268435456"
    }
  ],
  "outcome": "protocolError"
}
