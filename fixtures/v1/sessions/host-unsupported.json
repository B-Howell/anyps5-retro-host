{
  "description": "The host answers hello with unsupported and exits.",
  "tests": [
    "launcher"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8",
          "bgra8"
        ]
      },
      "anyValueFor": [
        "minVersion",
        "maxVersion",
        "pixelFormats"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "unsupported",
        "minVersion": 9,
        "maxVersion": 9,
        "pixelFormats": [
          "rgba8"
        ]
      }
    },
    {
      "hostExits": 0
    }
  ],
  "outcome": "unsupported"
}
