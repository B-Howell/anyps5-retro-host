{
  "description": "A ping has no pong after 5 seconds.",
  "tests": [
    "launcher"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8",
          "bgra8"
        ]
      },
      "anyValueFor": [
        "pixelFormats"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "welcome",
        "version": 1,
        "pid": 4242,
        "hostVersion": "1.0.0",
        "capabilities": [
          "ps1"
        ],
        "pixelFormat": "rgba8"
      },
      "anyValueFor": [
        "pid",
        "hostVersion",
        "pixelFormat"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 1,
        "method": "start",
        "args": {
          "core": "${core}",
          "disc": "${disc}",
          "system": "${system}",
          "saves": "${saves}",
          "internalResolution": "4",
          "options": {
            "swanstation_GPU_TextureFilter": "Bilinear"
          }
        }
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "reply",
        "id": 1,
        "result": {
          "epoch": 1
        }
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "ping",
        "id": 1
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "silence": 5.5
    },
    {
      "launcherKillsHost": true
    },
    {
      "launcherReports": {
        "method": "status",
        "result": {
          "ready": false,
          "ended": true,
          "error": "The emulator stopped responding and was closed."
        }
      }
    }
  ],
  "outcome": "hostFailure"
}
