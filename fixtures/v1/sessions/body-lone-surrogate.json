{
  "description": "The host sends a string with a lone surrogate.",
  "tests": [
    "launcher"
  ],
  "steps": [
    {
      "from": "launcher",
      "message": {
        "type": "hello",
        "minVersion": 1,
        "maxVersion": 1,
        "pixelFormats": [
          "rgba8",
          "bgra8"
        ]
      },
      "anyValueFor": [
        "pixelFormats"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "welcome",
        "version": 1,
        "pid": 4242,
        "hostVersion": "1.0.0",
        "capabilities": [
          "ps1",
          "ps1Lockstep",
          "ps1Rollback"
        ],
        "pixelFormat": "rgba8"
      },
      "anyValueFor": [
        "pid",
        "hostVersion",
        "pixelFormat"
      ]
    },
    {
      "from": "launcher",
      "message": {
        "type": "call",
        "id": 1,
        "method": "volume",
        "args": {
          "level": 1,
          "muted": false
        }
      },
      "anyValueFor": [
        "id",
        "args"
      ]
    },
    {
      "from": "host",
      "message": {
        "type": "reply",
        "id": 1,
        "result": null
      },
      "anyValueFor": [
        "id"
      ]
    },
    {
      "from": "host",
      "bytes": "1f0000007b2274797065223a2270696e67222c226e6f7465223a225c7564383030227d",
      "invalid": "a string holds a lone surrogate"
    }
  ],
  "outcome": "protocolError"
}
